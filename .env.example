# ==============================================================================
# GeFi Docs - Frontend
#
# Copie para `.env` (que e ignorado pelo git) e ajuste por maquina/ambiente.
# NUNCA coloque segredo em variavel NEXT_PUBLIC_*: elas sao embutidas no
# JavaScript entregue ao navegador e ficam legiveis para qualquer visitante.
# ==============================================================================

# ------------------------------------------------------------------------------
# BUILD-TIME (congelado no bundle)
# ------------------------------------------------------------------------------

# Base das chamadas do axios.
#
# `/api` = same-origin: o navegador chama a propria origem e o servidor do Next
# repassa para API_UPSTREAM (ver abaixo). E o valor usado no Docker, e o que
# permite a MESMA imagem servir local, dev e stage.
#
# Em `pnpm dev` fora do container, aponte direto para o backend local
# (o gefi-backend publica em 127.0.0.1:3200):
#   NEXT_PUBLIC_API_URL=http://localhost:3200/api
NEXT_PUBLIC_API_URL=/api

# ------------------------------------------------------------------------------
# RUNTIME (lido pelo servidor do Next a cada start, nao vai para o bundle)
# ------------------------------------------------------------------------------

# Destino do proxy de /api, lido a cada request por src/app/api/[...path]/route.ts.
# SEM barra no final. Vazio => /api responde 503 explicando a falta da config.
#   dev    http://gefi-api.dev.svc.cluster.local:3000
#   stage  https://api-stage.exemplo.com
# Fora do Docker (pnpm dev), o backend local. 3200 e a porta que o compose do
# gefi-backend publica no HOST -- a 3000 e deste frontend em `pnpm dev`, e por
# isso as duas colidiam.
API_UPSTREAM=http://localhost:3200

# Mesmo destino, na perspectiva de DENTRO do container (onde `localhost` e o
# proprio container). Lido pelo docker-compose.yml.
#
# O default do servico `web` e http://gefi-api:3000 -- o nome do container do
# gefi-backend na rede `gefi-backend_default`, a qual o front se conecta. Pela
# rede interna do Docker nao ha volta pelo host nem necessidade de publicar porta.
# Obrigatoria para o servico `web-dev`.
DOCKER_API_UPSTREAM=http://gefi-api:3000

# ------------------------------------------------------------------------------
# LOGIN COM GOOGLE (build-time)
# ------------------------------------------------------------------------------

# Client ID do tipo "Web application", criado em console.cloud.google.com >
# APIs & Services > Credentials. Termina em .apps.googleusercontent.com.
#
# Esta variavel e PUBLICA por natureza -- o navegador precisa dela para montar
# o botao, e um Client ID nao e segredo. O Client SECRET nao e usado neste
# fluxo e NUNCA deve aparecer aqui.
#
# Lembre de cadastrar em "Authorized JavaScript origins", no Google Cloud, TODAS
# as origens de onde o navegador carrega o FRONTEND (nao a do backend):
#   http://localhost:3000   pnpm dev
#   http://localhost:3100   docker compose up
#   a URL de stage/producao
# Sem isso o botao carrega, mas o login e recusado pelo Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dominio sugerido no seletor de contas do Google. E apenas conveniencia de
# interface: a restricao que vale e a do backend (GOOGLE_ALLOWED_HD), porque
# qualquer valor definido aqui pode ser contornado pelo cliente.
NEXT_PUBLIC_GOOGLE_HD=ifal.edu.br
