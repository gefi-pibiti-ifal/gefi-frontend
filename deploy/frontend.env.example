# ==============================================================================
# Modelo do arquivo /opt/gefi/frontend.env NO SERVIDOR.
# Copie para la, preencha e NUNCA coloque o arquivo preenchido no git.
# ==============================================================================

# Endereco publico do site.
#   Sem dominio ainda:  SITE_ADDRESS=:80
#   Com dominio:        SITE_ADDRESS=gefi.ifal.edu.br
SITE_ADDRESS=:80

# Client ID do Google (o MESMO do backend). Publico por natureza.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dominio sugerido no seletor de contas do Google.
NEXT_PUBLIC_GOOGLE_HD=ifal.edu.br
