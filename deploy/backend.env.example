# ==============================================================================
# Modelo do arquivo /opt/gefi/backend.env NO SERVIDOR (lido pelo deploy do
# gefi-backend). Explicacao de cada variavel: gefi-backend/.env.example.
# NUNCA coloque o arquivo preenchido no git.
# ==============================================================================
NODE_ENV=production
PORT=3000

POSTGRES_USER=gefi
# gere com: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=gefi_db
# DATABASE_URL nao e necessario aqui: o compose monta a partir dos 3 acima.

# gere com: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h

# true quando o site estiver em HTTPS (com dominio). Com acesso por http://IP,
# o navegador descarta cookie "Secure" e o login nao funciona.
COOKIE_SECURE=true

GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HD=ifal.edu.br
BOOTSTRAP_ADMIN_EMAILS=
CORS_ORIGIN=

OPENAI_API_KEY=
GOOGLE_API_KEY=

# A API so e acessada pelo frontend (rede interna do Docker): nao expor.
API_BIND=127.0.0.1
RUN_MIGRATIONS=true
